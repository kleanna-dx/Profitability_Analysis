# ============================================================
# 수익성 분석 NLQ 서버 — 환경변수 설정 템플릿
# ============================================================
# 이 파일을 복사하여 .env 파일을 생성하세요:
#   cp .env.example .env
#   그 후 DB 접속정보만 실제 환경에 맞게 수정하세요.
# ============================================================

# ── OpenAI 호환 API 설정 ─────────────────────────────────────
# GenSpark LLM 프록시 키 (GenSpark 사이트 → LLM API 키 관리에서 발급)
# ★ 자체 서버에서도 이 키와 URL을 그대로 사용하면 됩니다
OPENAI_API_KEY=여기에_GenSpark_LLM_프록시_키_입력
OPENAI_BASE_URL=https://www.genspark.ai/api/llm_proxy/v1

# ── AI 모델 설정 ─────────────────────────────────────────────
# GenSpark 프록시 지원 모델: gpt-5, gpt-5.1, gpt-5.2, gpt-5-mini, gpt-5-nano 등
GPT_MODEL=gpt-5-mini

# 임베딩 모델 (RAG 벡터 검색용)
EMBEDDING_MODEL=text-embedding-3-small

# ── MariaDB/MySQL 접속 설정 ──────────────────────────────────
# ★ 아래 항목은 자체 서버 환경에 맞게 반드시 수정하세요
DB_HOST=localhost
DB_PORT=3306
DB_USER=company
DB_PASSWORD=여기에_실제_비밀번호_입력
DB_NAME=company_board
DB_POOL_SIZE=5
