# ============================================================
# 수익성 분석 NLQ 서버 — 환경변수 설정 템플릿
# ============================================================
# 이 파일을 복사하여 .env 파일을 생성하세요:
#   cp .env.example .env
#   그 후 각 값을 실제 환경에 맞게 수정하세요.
# ============================================================

# ── OpenAI API 설정 ──────────────────────────────────────────
# [필수] OpenAI API 키 (https://platform.openai.com/api-keys 에서 발급)
OPENAI_API_KEY=sk-여기에_실제_API_키를_입력하세요

# [선택] OpenAI API Base URL (기본값: https://api.openai.com/v1)
# OpenAI 직접 연결 시 생략하거나 아래 기본값 사용
# Azure OpenAI 사용 시: https://your-resource.openai.azure.com/openai/deployments/your-deployment
OPENAI_BASE_URL=https://api.openai.com/v1

# ── AI 모델 설정 ─────────────────────────────────────────────
# [선택] GPT 모델명 (기본값: gpt-4o-mini)
# 추천 모델:
#   gpt-4o-mini  — 비용 효율적, 빠른 응답 (기본값, 권장)
#   gpt-4o       — 더 높은 정확도, 비용 증가
#   gpt-4-turbo  — 고성능, 높은 비용
GPT_MODEL=gpt-4o-mini

# [선택] 임베딩 모델명 (기본값: text-embedding-3-small)
# RAG 벡터 검색에 사용됨. 변경 시 기존 임베딩 재생성 필요!
EMBEDDING_MODEL=text-embedding-3-small

# ── MariaDB/MySQL 접속 설정 ──────────────────────────────────
# [필수] 데이터베이스 호스트
DB_HOST=localhost

# [선택] 데이터베이스 포트 (기본값: 3306)
DB_PORT=3306

# [필수] 데이터베이스 사용자명
DB_USER=company

# [필수] 데이터베이스 비밀번호
DB_PASSWORD=여기에_실제_비밀번호를_입력하세요

# [필수] 데이터베이스명
DB_NAME=company_board

# [선택] 커넥션 풀 크기 (기본값: 5)
DB_POOL_SIZE=5

# ── 서버 설정 ────────────────────────────────────────────────
# [선택] 서버 포트 (기본값: 3000)
# PORT=3000
